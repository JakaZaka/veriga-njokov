<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2C2C2C">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header with Back Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Simulated Sensors"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:layout_marginStart="8dp" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <!-- Template Selection -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#363636">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Predloge simulacij"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/templateStoreCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👥 Število ljudi v trgovini"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#FF6B35"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/templateTemperature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌡️ Temperatura (FERI primer)"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#FF6B35"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/templateHumidity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💧 Vlažnost"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#FF6B35"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/templateStockLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📦 Zaloga artiklov"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#FF6B35"
                        style="@style/Widget.MaterialComponents.Button" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Simulation Configuration -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#363636">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Name with icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/simulationNameLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Temperature"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FF6B35" />
                    </LinearLayout>

                    <!-- Range Display -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊 "
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/rangeDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="From -20.00 to 36.00"
                            android:textSize="16sp"
                            android:textColor="#FF6B35" />
                    </LinearLayout>

                    <!-- Interval Display -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏱️ "
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/intervalDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Every 10 minutes"
                            android:textSize="16sp"
                            android:textColor="#FF6B35" />
                    </LinearLayout>

                    <!-- Location Display -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍 "
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/locationDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Koroška cesta 46, Maribor"
                            android:textSize="16sp"
                            android:textColor="#FF6B35" />
                    </LinearLayout>

                    <!-- Enable/Disable Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Status"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enabled"
                            android:textSize="16sp"
                            android:textColor="#4CAF50"
                            android:layout_marginEnd="16dp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/simulationToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detailed Configuration -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#363636">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Podrobne nastavitve"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="12dp" />

                    <!-- Min Value -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Minimalna vrednost"
                        android:layout_marginBottom="8dp"
                        android:textColorHint="#AAAAAA"
                        app:boxStrokeColor="#FF6B35"
                        app:hintTextColor="#FF6B35"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/minValueInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberSigned|numberDecimal"
                            android:text="-20.0"
                            android:textColor="#FFFFFF" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Max Value -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Maksimalna vrednost"
                        android:layout_marginBottom="8dp"
                        android:textColorHint="#AAAAAA"
                        app:boxStrokeColor="#FF6B35"
                        app:hintTextColor="#FF6B35"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/maxValueInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberSigned|numberDecimal"
                            android:text="36.0"
                            android:textColor="#FFFFFF" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Interval -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Interval (minute)"
                        android:layout_marginBottom="8dp"
                        android:textColorHint="#AAAAAA"
                        app:boxStrokeColor="#FF6B35"
                        app:hintTextColor="#FF6B35"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/intervalInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="10"
                            android:textColor="#FFFFFF" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Unit -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enota"
                        android:layout_marginBottom="8dp"
                        android:textColorHint="#AAAAAA"
                        app:boxStrokeColor="#FF6B35"
                        app:hintTextColor="#FF6B35"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/unitInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:text="°C"
                            android:textColor="#FFFFFF" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Location Address -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Lokacija"
                        android:textColorHint="#AAAAAA"
                        app:boxStrokeColor="#FF6B35"
                        app:hintTextColor="#FF6B35"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/locationInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:text="Koroška cesta 46, Maribor"
                            android:textColor="#FFFFFF" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Extreme Event Configuration -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#363636">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Ekstremni dogodki"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="12dp" />

                    <CheckBox
                        android:id="@+id/enableExtremeCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Omogoči avtomatsko obvestilo"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Prag za opozorilo"
                        android:layout_marginBottom="8dp"
                        android:textColorHint="#AAAAAA"
                        app:boxStrokeColor="#FF6B35"
                        app:hintTextColor="#FF6B35"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/extremeThresholdInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberSigned|numberDecimal"
                            android:text="50"
                            android:textColor="#FFFFFF" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pogoj"
                        android:textColor="#AAAAAA"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/extremeConditionSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/btn_dropdown"
                        android:backgroundTint="#FF6B35" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Simulations List -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#363636">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aktivne simulacije"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/activeSimulationsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ni aktivnih simulacij"
                        android:textSize="14sp"
                        android:textColor="#AAAAAA" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Shrani nastavitve"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4CAF50"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.MaterialComponents.Button" />

                <Button
                    android:id="@+id/stopAllButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ustavi vse"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#F44336"
                    android:layout_marginStart="8dp"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

